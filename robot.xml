<mujoco>
  <worldbody>
    <light diffuse=".5 .5 .5"/>
    <body name="chassis" pos="0 0 0.26" euler="0 0 0">
      <freejoint/> 
      <body name = "arm">
        <include file="arm/mounted_arm.xml"/>
      </body>
      <geom type="box" size="0.35 0.5 0.05" pos="0 0 0" mass="10"/>

      <camera mode="fixed" pos="0 0.3 0.2" euler="90 0 0"/>

      <!-- Wheels -->
      <body pos="0.5 -0.5 -0.1" euler="0 0 -90">
        <include file="front_right_wheel.xml"/>
      </body>
      
      <body pos="0.5 0.5 -0.1" euler="0 0 -90">
        <include file="front_left_wheel.xml"/>
      </body>
      
      <body pos="-0.5 -0.5 -0.1" euler="0 0 -90">
        <include file="rear_right_wheel.xml"/>
      </body>
      
      <body pos="-0.5 0.5 -0.1" euler="0 0 -90">
        <include file="rear_left_wheel.xml"/>
      </body>

    </body>
  </worldbody>

  <actuator>
    <!-- Force motors on wheel rolling joints -->
    <motor name="motor_fr" joint="R1_fr_wheel_rolling_joint" gear="50"/>
    <motor name="motor_fl" joint="R1_fl_wheel_rolling_joint" gear="50"/>
    <motor name="motor_rr" joint="R1_rr_wheel_rolling_joint" gear="50"/>
    <motor name="motor_rl" joint="R1_rl_wheel_rolling_joint" gear="50"/>
    <include file="arm/arm_actuators.xml"/>
  </actuator>
</mujoco>
