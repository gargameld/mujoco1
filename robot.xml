<mujoco>
  <worldbody>
    <light diffuse=".5 .5 .5"/>
    <geom type="plane" size="0.5 0.5 0.005" pos="0 0 0"/>

    <body name="chassis" pos="0 0 0.005" euler="0 0 0">
      <freejoint/> 
      <geom type="box" size="0.05 0.05 0.025" pos="0 0 0.05"/>
      
      <camera mode="fixed" pos="0 0.05 0.025" euler="90 0 0"/>
      
      <body pos="0.06 0.05 0.025">
        <joint name="fr" type="hinge" pos="0 0 0" axis="1 0 0" damping="0.5"/>
        <geom type="cylinder" size="0.015 0.01" euler="0 90 0" pos="0 0 0"/>
      </body>
      
      <body pos="-0.06 0.05 0.025">
        <joint name="fl" type="hinge" pos="0 0 0" axis="1 0 0" damping="0.5"/>
        <geom type="cylinder" size="0.015 0.01" euler="0 90 0" pos="0 0 0"/>
      </body>
      
      <body pos="0.06 -0.05 0.025">
        <joint name="br" type="hinge" pos="0 0 0" axis="1 0 0" damping="0.5"/>
        <geom type="cylinder" size="0.015 0.01" euler="0 90 0" pos="0 0 0"/>
      </body>
      
      <body pos="-0.06 -0.05 0.025">
        <joint name="bl" type="hinge" pos="0 0 0" axis="1 0 0" damping="0.5"/>
        <geom type="cylinder" size="0.015 0.01" euler="0 90 0" pos="0 0 0"/>
      </body>
    </body>
  </worldbody>

  <equality>
    <joint joint1="fr" joint2="fl"/>
    <joint joint1="br" joint2="bl"/>
  </equality>

  <actuator>
    <motor name="drive_fr" joint="fr" gear="25"/>
    <motor name="drive_fl" joint="fl" gear="25"/>
    <motor name="drive_br" joint="br" gear="25"/>
    <motor name="drive_bl" joint="bl" gear="25"/>
  </actuator>
</mujoco>