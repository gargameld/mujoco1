<mujoco>
  <option timestep="0.0005"/>
  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="1 0 0" rgb2="0 1 0" width="512" height="512"/>

    <texture name="tex_black" builtin="flat" height="32" width="32" rgb1="0 0 0" type="2d"/>
    <texture name="tex_magenta" builtin="flat" height="32" width="32" rgb1="1 0 1" type="2d"/>
    <texture name="tex_red" builtin="flat" height="32" width="32" rgb1="1 0 0" type="2d"/>
    <texture name="tex_blue" builtin="flat" height="32" width="32" rgb1="0 0 1" type="2d"/>

    <material name="mat_black" texture="tex_black"/>
    <material name="mat_magenta" texture="tex_magenta"/>
    <material name="mat_red" texture="tex_red"/>
    <material name="mat_blue" texture="tex_blue"/>
  </asset>
  <default>
    <geom solimp=".9 .95 .001" solref=".02 1"/>
  </default>

  <include file="robot.xml"/>

  <worldbody>
    <light diffuse=".5 .5 .5"/>
    <geom type="plane" size="100 100 0.1" pos="0 0 0"/>

    <body name="quoridor" pos="0 4 0">
      <geom type="box" size="0.05 2 0.5" pos="-2.5 2 0.5" material="mat_black"/>
      <geom type="box" size="0.05 2 0.5" pos="-2.5 -2 0.5" material="mat_magenta"/>

      <geom type="box" size="0.05 2 0.5" pos="2.5 2 0.5" material="mat_red"/>
      <geom type="box" size="0.05 2 0.5" pos="2.5 -2 0.5" material="mat_blue"/>
      <geom type="box" size="2.5 0.05 0.5" pos="0 4 0.5"/>
    </body>

    <body name="parkings" pos="0 -4 0">
      <geom type="box" size="0.05 4 0.5" pos="-2.5 0 0.5"/>
      <geom type="box" size="2.5 0.05 0.5" pos="0 -4 0.5"/>

      <body name="parking1" pos="2.5 -3 0">
        <geom type="box" size="1 0.05 0.5" pos="1 0.7 0.5"/>
        <geom type="box" size="1 0.05 0.5" pos="1 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="2 0 0.5" material="mat_blue"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
      </body>

      <body name="parking2" pos="2.5 -1 0">
        <geom type="box" size="1 0.05 0.5" pos="1 0.7 0.5"/>
        <geom type="box" size="1 0.05 0.5" pos="1 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="2 0 0.5" material="mat_red"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
      </body>

      <body name="parking3" pos="2.5 1 0">
        <geom type="box" size="1 0.05 0.5" pos="1 0.7 0.5"/>
        <geom type="box" size="1 0.05 0.5" pos="1 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="2 0 0.5" material="mat_black"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
      </body>

      <body name="parking4" pos="2.5 3 0">
        <geom type="box" size="1 0.05 0.5" pos="1 0.7 0.5"/>
        <geom type="box" size="1 0.05 0.5" pos="1 -0.7 0.5"/>
        <geom type="box" size="0.05 0.7 0.5" pos="2 0 0.5" material="mat_magenta"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 -0.85 0.5"/>
        <geom type="box" size="0.05 0.15 0.5" pos="0 0.85 0.5"/>
      </body>

    </body>
  </worldbody>
</mujoco>